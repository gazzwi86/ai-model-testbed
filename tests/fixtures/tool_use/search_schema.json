{
  "openapi": "3.0.3",
  "info": {
    "title": "Search API",
    "version": "1.0.0",
    "description": "A web search tool that returns ranked results for a text query."
  },
  "servers": [
    {
      "url": "https://api.search-fixture.example.com/v1"
    }
  ],
  "paths": {
    "/search": {
      "get": {
        "operationId": "search",
        "summary": "Search for information using a text query",
        "description": "Performs a web search and returns a ranked list of results with titles, URLs, and snippets.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "The search query string. Should be a natural language query or keywords.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          {
            "name": "max_results",
            "in": "query",
            "required": false,
            "description": "Maximum number of results to return.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          },
          {
            "name": "safe_search",
            "in": "query",
            "required": false,
            "description": "Whether to filter adult content from results.",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful search response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string",
                      "description": "The original search query"
                    },
                    "total_results": {
                      "type": "integer",
                      "description": "Estimated total number of matching results"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string",
                            "description": "Title of the search result"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "URL of the search result"
                          },
                          "snippet": {
                            "type": "string",
                            "description": "A brief text excerpt from the page showing relevant context"
                          },
                          "published_date": {
                            "type": "string",
                            "format": "date",
                            "description": "Publication date of the content, if available"
                          }
                        },
                        "required": ["title", "url", "snippet"]
                      }
                    }
                  },
                  "required": ["query", "results"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (e.g., empty query)"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    }
  }
}
